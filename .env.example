# Copy this file to .env and fill in real values. Never commit .env.
# Every variable is explained in the README ("Environment variables").

# --- Slack: from your Slack app (api.slack.com/apps) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_USER_ID=U...

# --- Groq (the AI provider, via LiteLLM): console.groq.com ---
GROQ_API_KEY=...

# --- WHOOP: from your app at developer.whoop.com ---
WHOOP_CLIENT_ID=...
WHOOP_CLIENT_SECRET=...
# Filled in for you by `python scripts/whoop_auth.py`; leave as is until you run it.
WHOOP_REFRESH_TOKEN=

# --- Optional: nightly backup link (VM only), see deploy/README.md ---
BACKUP_PAR_URL=
